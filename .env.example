# ==============================================================================
# AI Support Ticket Analysis System - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: groq, ollama, fallback
# - 'groq': Cloud LLM with free tier (fastest, recommended)
# - 'ollama': Local offline LLM (requires Ollama running locally)
# - 'fallback': Offline deterministic heuristic engine (no external dependencies)
LLM_PROVIDER=groq

# Groq Free-Tier API Configuration
# Get a 100% free key in 30 seconds at: https://console.groq.com/keys (no credit card required)
# If left empty, system automatically degrades gracefully to the offline deterministic fallback.
GROQ_API_KEY=

# Groq Model Name (active free-tier models: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama Configuration (only used if LLM_PROVIDER=ollama or as local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Service Network Configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_PORT=8501

# Logging
LOG_LEVEL=INFO
